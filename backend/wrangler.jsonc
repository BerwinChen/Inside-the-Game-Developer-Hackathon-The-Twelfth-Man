{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "touchline-match-lab",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AI_BACKEND": "foundry",
    "FOUNDRY_ENDPOINT": "https://ai4soccer.services.ai.azure.com/api/projects/inside-the-game/agents/twelfth-man-team/endpoint/protocols/invocations",
    "OPENAI_MODEL": "gpt-5.4-mini",
    "WEB_SEARCH_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "8766001",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
